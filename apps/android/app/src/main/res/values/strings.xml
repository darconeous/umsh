    <string name="storage_unavailable_title">Storage unavailable</string>
    <!-- First paragraph. -->
    <string name="storage_unavailable_body">UMSH could not open its local database, so your contacts and conversations can’t be shown and nothing new can be saved.</string>
    <!-- Second paragraph, emphasized. -->
    <string name="storage_unavailable_intact">Your records have not been deleted.</string>
    <!-- Third paragraph. "The error below" is the diagnostic line under it. -->
    <string name="storage_unavailable_advice">Don’t uninstall the app or clear its storage. That erases them, and your identity with them. An update that fixes the error below restores everything.</string>

    <!-- Identity unavailable: Android isn't ready to hand over the identity. -->
    <!-- Title. -->
    <string name="identity_unavailable_title">Identity unavailable</string>
    <!-- First paragraph. -->
    <string name="identity_unavailable_body">UMSH can’t open this phone’s identity right now.</string>
    <!-- Second paragraph, emphasized. -->
    <string name="identity_unavailable_intact">Nothing has been lost.</string>

    <!-- Identity lost: the identity is stored but can never be opened again. -->
    <!-- Title. -->
    <string name="identity_lost_title">Identity can’t be opened</string>
    <!-- First paragraph. -->
    <string name="identity_lost_body">This phone’s identity is stored but can no longer be opened, so UMSH can’t run as this node.</string>
    <!-- Second paragraph, emphasized. -->
    <string name="identity_lost_intact">Your messages and peers have not been deleted.</string>
    <!-- Third paragraph, above the Erase identity button. -->
    <string name="identity_lost_advice">Erase identity makes this phone a new node. Old messages stay but are unreachable.</string>

    <!-- Manage space: opened from Android's App info › Storage in place of Clear storage. -->
    <!-- Title. -->
    <string name="manage_space_title">UMSH storage</string>
    <!-- Section header: what uses this app's storage. -->
    <string name="space_used">Space used</string>
    <!-- Space used by the databases. -->
    <string name="space_messages">Messages and peers</string>
    <!-- Space used by the identity and channel keys. -->
    <string name="space_keys">Identity and keys</string>
    <!-- Under Erase identity in Manage space. -->
    <string name="erase_identity_detail">Keeps messages and peers</string>
    <!-- Destructive row: erases everything the app holds. -->
    <string name="start_over">Start over</string>
    <!-- Under Start over. "Clear storage" is Android's button name. -->
    <string name="start_over_detail">Erases everything, like Clear storage</string>
    <!-- First confirmation title before Start over. -->
    <string name="start_over_title">Start over?</string>
    <!-- First confirmation body before Start over. -->
    <string name="start_over_body">Your identity, messages, contacts, channels, and paired radio are all erased. UMSH comes back as a first launch.</string>
    <!-- Destructive button in both Start over confirmations. -->
    <string name="start_over_confirm">Erase everything</string>
    <!-- Second confirmation title before Start over. -->
    <string name="start_over_again_title">This cannot be undone.</string>
    <!-- Second confirmation body before Start over. -->
    <string name="start_over_again_body">Every message on this phone will be erased.</string>
    <!-- Conversation list. -->
    <!-- The conversation list while the phone's stored conversations are still being read. -->
    <string name="conversations_loading">Loading conversations…</string>
    <!-- The conversation list when there are none. -->
    <string name="conversations_empty_title">No conversations</string>
    <!-- TalkBack: the top app bar's Search action. -->
    <string name="action_search">Search</string>
    <!-- Placeholder in the search field over conversations, peers and channels: what it matches. -->
    <string name="search_placeholder">Name, alias, address, or hint</string>
    <!-- TalkBack: empties the search field. -->
    <string name="action_clear_search">Clear search</string>
    <!-- Search results section: conversations that already exist. -->
    <string name="search_section_conversations">Conversations</string>
    <!-- Search results section: saved peers with no conversation yet. -->
    <string name="search_section_peers">Peers</string>
    <!-- Search results section: channels this phone joined with no conversation yet. -->
    <string name="search_section_channels">Channels</string>
    <!-- Footer under the Channels search results. -->
    <string name="search_channels_footer">Joined, no conversation yet</string>
    <!-- Search results section: nodes heard over the air but not saved. -->
    <string name="search_section_discovered">Discovered nodes</string>
    <!-- Footer under the Discovered nodes search results. -->
    <string name="search_discovered_footer">Heard nearby, not saved</string>
    <!-- Search found nothing. -->
    <string name="search_nothing">Nothing matches this search.</string>
    <!-- A channel's kind, under its name: one of the channels every phone starts with. -->
    <string name="channel_kind_builtin">Built-in</string>
    <!-- A channel's kind, under its name: joined by name, so anyone who knows the name can read it. -->
    <string name="channel_kind_named">Public</string>
    <!-- A channel's kind, under its name: joined with a secret key. -->
    <string name="channel_kind_private">Private</string>
    <!-- Title of a node that has no alias and advertised no name. -->
    <string name="unnamed_node">Unnamed node</string>
    <!-- Title and role line of this phone's own companion radio among the peers. -->
    <string name="companion_radio">Companion radio</string>
    <!-- Conversation row preview: an unsent draft. Keep the annotation around the label, which is drawn in the error color. -->
    <string name="preview_draft"><annotation type="draft">Draft:</annotation> <xliff:g id="draft" example="Bring the spare antenna">%1$s</xliff:g></string>
    <!-- Conversation row preview: the last message was deleted. -->
    <string name="preview_deleted">Message deleted</string>
    <!-- Conversation row preview: the conversation has no messages. -->
    <string name="preview_none">No messages yet</string>
    <!-- Conversation row preview: the last message is one this phone sent. -->
    <string name="preview_mine">You: <xliff:g id="message" example="Thanks! Got it.">%1$s</xliff:g></string>
    <!-- Conversation row preview in a channel: who sent the last message, then the message. -->
    <string name="preview_channel_sender"><xliff:g id="sender" example="Ana">%1$s</xliff:g>: <xliff:g id="message" example="Trail’s clear past the second bridge">%2$s</xliff:g></string>
    <!-- Status text, like an IRC /me: a person's name, then what they say they did ("Ridge Medic is at the saddle"). -->
    <string name="status_line"><xliff:g id="name" example="Ridge Medic">%1$s</xliff:g> <xliff:g id="status" example="is at the saddle">%2$s</xliff:g></string>
    <!-- Status text of this phone's own, while it advertises no name: the subject of the line. -->
    <string name="status_you">You</string>
    <!-- A channel member this phone cannot name, by its node hint. "Member" is a channel's member. -->
    <string name="member_hint">Member <xliff:g id="hint" example="BtC5">%1$s</xliff:g></string>
    <!-- A channel member about whom nothing is known, not even a node hint. "Member" is a channel's member. -->
    <string name="member_unknown">Member</string>
    <!-- TalkBack, conversation row: how many messages are unread. -->
    <plurals name="row_unread_messages">
        <item quantity="one"><xliff:g id="count" example="1">%d</xliff:g> unread message</item>
        <item quantity="other"><xliff:g id="count" example="2">%d</xliff:g> unread messages</item>
    </plurals>
    <!-- TalkBack, conversation row: the conversation's notifications are off. -->
    <string name="row_muted">Muted</string>
    <!-- Conversation row action (TalkBack actions menu, and the swipe): delete a direct conversation. -->
    <string name="action_delete_conversation">Delete conversation</string>
    <!-- Conversation row action (TalkBack actions menu, and the swipe): leave a channel's chat; the phone stays in the channel. -->
    <string name="action_leave_chat">Leave chat</string>
    <!-- Revealed by swiping a direct conversation's row: deletes it, after asking. -->
    <string name="swipe_delete">Delete</string>
    <!-- Revealed by swiping a channel conversation's row: leaves its chat, after asking. -->
    <string name="swipe_leave">Leave</string>
    <!-- Confirmation title before deleting a direct conversation. -->
    <string name="delete_conversation_title">Delete this conversation?</string>
    <!-- Confirmation body before deleting a direct conversation; the peer's name. -->
    <string name="delete_conversation_body">The message history on this phone is removed. <xliff:g id="peer" example="Kestrel">%1$s</xliff:g> keeps their copy.</string>
    <!-- Destructive button: deletes the conversation. -->
    <string name="delete_conversation_confirm">Delete</string>
    <!-- Confirmation title before leaving a channel's chat; the channel's name, in quotes. -->
    <string name="leave_chat_title">Leave “<xliff:g id="channel" example="hike-club">%1$s</xliff:g>” chat?</string>
    <!-- Confirmation body before leaving a channel's chat. -->
    <string name="leave_chat_body">The messages on this phone are removed. You stay in the channel, and a new message opens this conversation again.</string>
    <!-- Destructive button: leaves the channel's chat. -->
    <string name="leave_chat_confirm">Leave</string>
    <!-- Failure dialog title: a direct conversation was not deleted. -->
    <string name="delete_failed_title">Couldn’t delete this conversation</string>
    <!-- Failure dialog title: a channel's chat was not left. -->
    <string name="leave_failed_title">Couldn’t leave this chat</string>
    <!-- Failure dialog body: a conversation was not deleted or left. -->
    <string name="remove_failed_body">Nothing was removed.</string>
    <!-- Failure dialog title: a conversation found by search could not be opened or started. -->
    <string name="open_failed_title">Couldn’t open this conversation</string>
    <!-- Failure dialog body: a conversation found by search could not be opened or started. -->
    <string name="open_failed_body">No conversation was started.</string>

    <!-- Threads. -->
    <!-- A deleted message of mine, an italic line in the transcript in place of its bubble. -->
    <string name="message_you_deleted">You deleted a message</string>
    <!-- A message its sender deleted, an italic line in the transcript; also a reply's quote of one. -->
    <string name="message_deleted">Message deleted</string>
    <!-- In the transcript: a missing message that never arrived. -->
    <string name="message_unavailable">Message unavailable</string>
    <!-- TalkBack: a placeholder for messages that did not arrive. -->
    <plurals name="gap_missing">
        <item quantity="one">A missing message</item>
        <item quantity="other"><xliff:g id="count" example="3">%d</xliff:g> missing messages</item>
    </plurals>
    <!-- Under my message: it is being sent. -->
    <string name="caption_sending">Sending…</string>
    <!-- Under my message: it went out and no acknowledgment is expected (a channel). -->
    <string name="caption_sent">Sent</string>
    <!-- Under my message: repeaters were heard carrying it, none of which named itself. -->
    <plurals name="caption_heard_repeats">
        <item quantity="one">Heard a repeat</item>
        <item quantity="other">Heard <xliff:g id="count" example="3">%d</xliff:g> repeats</item>
    </plurals>
    <!-- Under my message: one repeater was heard carrying it; its name or router hint. -->
    <string name="caption_sent_via_one">Sent via <xliff:g id="repeater" example="Spencer Butte">%1$s</xliff:g></string>
    <!-- Under my message: several repeaters were heard carrying it; the first one's name or router hint, then how many others. -->
    <plurals name="caption_sent_via_others">
        <item quantity="one">Sent via <xliff:g id="repeater" example="Spencer Butte">%1$s</xliff:g> and <xliff:g id="count" example="1">%2$d</xliff:g> other</item>
        <item quantity="other">Sent via <xliff:g id="repeater" example="Spencer Butte">%1$s</xliff:g> and <xliff:g id="count" example="2">%2$d</xliff:g> others</item>
    </plurals>
    <!-- Under my direct message: it went out, and its acknowledgment is awaited. -->
    <string name="caption_confirming">Confirming delivery…</string>
    <!-- Under my newest direct message: its recipient acknowledged it. -->
    <string name="caption_delivered">Delivered</string>
    <!-- Under my direct message: acknowledged after it had been marked unconfirmed. -->
    <string name="caption_delivered_late">Delivered late</string>
    <!-- Under my direct message: acknowledged, but only after the mesh flooded it because the route failed. -->
    <string name="caption_delivered_flooded">Delivered · Flooded</string>
    <!-- Under my message, in the error color: it went out, but no acknowledgment came back. -->
    <string name="caption_unconfirmed">Unconfirmed</string>
    <!-- Under my message, in the error color: it never went out where its recipient could read it. -->
    <string name="caption_not_delivered">Not delivered</string>
    <!-- Under a message that was edited, alone. -->
    <string name="caption_edited">Edited</string>
    <!-- Under a message that was edited, then the rest of its caption, such as Delivered. -->
    <string name="caption_edited_pair">Edited · <xliff:g id="caption" example="Delivered">%1$s</xliff:g></string>
    <!-- Under a received message that arrived long after it was sent. -->
    <string name="caption_received_late">Received late</string>
    <!-- Under a message that arrived as an edit of a message this phone never received, shown as a message of its own. -->
    <string name="caption_edit_of_unknown">Received as an edit for an unknown previous message</string>
    <!-- A reply's quote of my own message: who wrote the original. -->
    <string name="quote_you">You</string>
    <!-- A reply's quote of a message this phone never had. -->
    <string name="quote_unknown">Reply to an unknown message</string>
    <!-- TalkBack action on a reply's quote: scrolls to the message it quotes. -->
    <string name="quote_show_original">Show original</string>
    <!-- TalkBack: a reaction chip; the emoji, then how many reacted with it. -->
    <plurals name="reaction_chip">
        <item quantity="one"><xliff:g id="emoji" example="👍">%1$s</xliff:g>, <xliff:g id="count" example="1">%2$d</xliff:g></item>
        <item quantity="other"><xliff:g id="emoji" example="👍">%1$s</xliff:g>, <xliff:g id="count" example="3">%2$d</xliff:g></item>
    </plurals>
    <!-- TalkBack: a reaction chip that includes mine; the emoji, then how many reacted with it. -->
    <plurals name="reaction_chip_yours">
        <item quantity="one"><xliff:g id="emoji" example="👍">%1$s</xliff:g>, <xliff:g id="count" example="1">%2$d</xliff:g>, including yours</item>
        <item quantity="other"><xliff:g id="emoji" example="👍">%1$s</xliff:g>, <xliff:g id="count" example="3">%2$d</xliff:g>, including yours</item>
    </plurals>
    <!-- TalkBack: a reaction of mine that was not delivered; the emoji. -->
    <string name="reaction_failed"><xliff:g id="emoji" example="👍">%1$s</xliff:g>, yours, not delivered</string>
    <!-- Button over the transcript: back to the newest message. -->
    <string name="jump_to_latest">Jump to latest</string>
    <!-- An empty thread's title. -->
    <string name="thread_empty_title">No messages yet</string>
    <!-- An empty direct thread's line; the peer's name. -->
    <string name="thread_empty_direct">Messages with <xliff:g id="peer" example="Kestrel">%1$s</xliff:g> will appear here.</string>
    <!-- An empty channel thread's line. -->
    <string name="thread_empty_channel">Messages sent to this channel by anyone holding its key will appear here.</string>
    <!-- The composer's placeholder; the conversation's name. -->
    <string name="composer_placeholder">Message <xliff:g id="conversation" example="Ridge Medic">%1$s</xliff:g></string>
    <!-- Above the composer when there is no radio or its link is down. -->
    <string name="composer_blocked">Connect a radio to send</string>
    <!-- Button, a verb: sends the message. -->
    <string name="action_send">Send</string>
    <!-- TalkBack: the Send button while the companion radio's link is coming up. -->
    <string name="send_unavailable_connecting">Send unavailable while the radio connects.</string>

    <!-- Peers list. -->
    <!-- Peers list section: favorite nodes. -->
    <string name="peers_section_favorites">Favorites</string>
    <!-- TalkBack: the state of a favorite peer in search results. -->
    <string name="search_favorite_state">Favorite</string>
    <!-- Peers list section: the other saved nodes. -->
    <string name="peers_section_saved">Saved</string>
    <!-- Peers list section: this phone's own companion radio. -->
    <string name="peers_section_companion_radio">Companion radio</string>
