<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- The app's name. A product name: not translated. -->
    <string name="app_name" translatable="false">UMSH</string>

    <!--
        Failure reasons. Each is the reason line of a failure dialog: why an
        action did not happen, never what to do about it.
    -->
    <!-- A command failed for a reason the app has no words for. -->
    <string name="reason_unknown">Something went wrong on this phone.</string>
    <!-- The phone's database failed. -->
    <string name="reason_store">Stored information could not be read.</string>
    <!-- A node's address did not decode. -->
    <string name="reason_invalid_input">That isn\'t a valid address.</string>
    <!-- The phone's mesh session would not make a request as asked. -->
    <string name="reason_invalid_request">This request can\'t be made.</string>
    <!-- A peer, channel or conversation was removed while its screen was open. -->
    <string name="reason_not_found">It is no longer on this phone.</string>
    <!-- Joining a channel: the phone holds as many as it can. -->
    <string name="reason_channel_table_full">This phone holds as many channels as it can.</string>
    <!-- Asked for something before this phone's identity has started. -->
    <string name="reason_not_running">Your identity isn\'t ready yet.</string>
    <!-- Asked for something while this phone's identity is starting, erasing or stopping. -->
    <string name="reason_busy">Not available while your identity is being set up or erased.</string>
    <!-- Asked for something while the app moves to another radio. -->
    <string name="reason_stopped">Not available while switching radios.</string>
    <!-- Android's keystore would not hand over a channel key yet. -->
    <string name="reason_vault_unavailable">Channel keys aren\'t available right now.</string>
    <!-- Android's keystore refused to read a channel key. -->
    <string name="reason_vault_failed">The channel key could not be read.</string>
    <!-- Erasing this phone's identity: its message counter files stayed. -->
    <string name="reason_counters_not_removed">Message counters could not be erased.</string>
    <!-- Why something could not be sent: no radio. -->
    <string name="reason_no_radio">No companion radio is connected.</string>
    <!-- Why something could not be sent: the radio belongs to another phone. -->
    <string name="reason_not_this_phone">This radio is not set up for this phone.</string>
    <!-- Managing a node: it acknowledged a request but never answered. -->
    <string name="reason_no_answer">No answer. This phone may not be one of its administrators.</string>
    <!-- Managing a node: a request was never acknowledged. -->
    <string name="reason_unreachable">Couldn\'t reach the device.</string>
    <!-- Managing a node: its reply did not decode. -->
    <string name="reason_unreadable">The device\'s answer couldn\'t be read. Its firmware may be newer than this app.</string>
    <!-- A request the person stopped. -->
    <string name="reason_cancelled">The operation was canceled.</string>
    <!-- The phone's radio could not transmit a request. -->
    <string name="reason_send_failed">The radio could not send it.</string>
    <!-- Firmware update: the device has no such update mode. -->
    <string name="reason_dfu_unsupported">This firmware does not support the requested update mode.</string>
    <!-- Firmware update: the device refused. The placeholder is a protocol status name, not translated. -->
    <string name="reason_dfu_refused">The device refused the update: <xliff:g id="status" example="BUSY">%1$s</xliff:g>.</string>
    <!-- Firmware update: the device never confirmed entering its update mode. -->
    <string name="reason_dfu_unconfirmed">The device did not confirm the update.</string>
    <!-- A send was refused because the EMERGENCY channel's warning has not been accepted. EMERGENCY is the channel's name and is not translated. -->
    <string name="reason_emergency_not_certified">Sending on <xliff:g id="channel">EMERGENCY</xliff:g> needs its warning accepted first.</string>
    <!-- A message was kept in the conversation, but the radio could not take it. -->
    <string name="reason_message_not_queued">It was saved but could not go out. It\'s marked Not delivered.</string>
    <!-- A message was kept, the radio could not take it, and recording that failed too. -->
    <string name="reason_message_not_recorded">It could not go out, and that could not be saved. It may show as sending until UMSH restarts.</string>
    <!-- Starting this phone's identity: the companion radio refused its host key. -->
    <string name="reason_start_host_key">The radio did not accept this phone\'s key.</string>
    <!-- Starting this phone's identity: its message counter files could not be used. -->
    <string name="reason_start_session">Message counters could not be opened.</string>
    <!-- Starting this phone's identity: the phone's database could not be readied. -->
    <string name="reason_start_store">Stored information could not be prepared.</string>
    <!-- Android's keystore would not hand over this phone's identity yet. -->
    <string name="reason_identity_unavailable">Your identity isn\'t available right now.</string>
    <!-- This phone's identity is stored but can no longer be read. -->
    <string name="reason_identity_lost">Your identity can no longer be read.</string>
    <!-- Design system. -->
    <!-- TalkBack: a peer's avatar. The placeholder is the node's hint, an identifier such as AP5R. -->
    <string name="avatar_node_hint">Node hint <xliff:g id="hint" example="AP5R">%1$s</xliff:g></string>
    <!-- TalkBack: a favorite peer's avatar. The placeholder is the node's hint, an identifier such as AP5R. -->
    <string name="avatar_favorite_node_hint">Favorite node, hint <xliff:g id="hint" example="AP5R">%1$s</xliff:g></string>
    <!-- TalkBack: a channel's badge. The placeholder is the channel's title. -->
    <string name="channel_badge">Channel <xliff:g id="title" example="Hot Topic">%1$s</xliff:g></string>
    <!-- TalkBack: the badge of a private channel that was never named. The placeholder is the channel's identifier, as the badge shows it. -->
    <string name="channel_badge_private">Private channel <xliff:g id="identifier" example="3F9A">%1$s</xliff:g></string>
    <!-- The built-in public channel's name. A channel name every node shares: not translated. -->
    <string name="channel_public" translatable="false">Public</string>
    <!-- The built-in emergency channel's name. A channel name every node shares: not translated. -->
    <string name="channel_emergency" translatable="false">EMERGENCY</string>
    <!-- Title of a private channel that was never named. Its badge shows its identifier. -->
    <string name="channel_private">Private channel</string>
    <!-- TalkBack action on a node's address: copies it. -->
    <string name="action_copy_address">Copy address</string>
    <!-- Brief notice after an address was copied. Shown on Android 12 and earlier only. -->
    <string name="copied_address">Address copied</string>
    <!-- Button: puts a failure's full error on the clipboard. -->
    <string name="copy_details">Copy details</string>
    <!-- Brief notice after a failure's details were copied. Shown on Android 12 and earlier only. -->
    <string name="details_copied">Details copied</string>
    <!-- Dismisses a dialog. -->
    <string name="dialog_ok">OK</string>

    <!-- Node roles. -->
    <!-- Node role: forwards other nodes' traffic. -->
    <string name="role_repeater">Repeater</string>
    <!-- Node role: a person's messaging device. -->
    <string name="role_chat">Chat</string>
    <!-- Node role: reports its position. -->
    <string name="role_tracker">Tracker</string>
    <!-- Node role: reports measurements. -->
    <string name="role_sensor">Sensor</string>
    <!-- Node role: links the mesh to another network. -->
    <string name="role_bridge">Bridge</string>
    <!-- Node role: hosts a shared conversation. -->
    <string name="role_chat_room">Chat room</string>
    <!-- Node role: a short-lived identity. -->
    <string name="role_temporary_session">Temporary session</string>
    <!-- Node role: none advertised, or one this app cannot name. -->
    <string name="role_unknown">Unknown</string>
    <!-- A node role this app has no name for, by its number. -->
    <string name="role_code">Role <xliff:g id="code" example="9">%1$d</xliff:g></string>

    <!-- Node capabilities. -->
    <!-- Node capability: forwards other nodes' traffic. -->
    <string name="capability_repeater">Repeater</string>
    <!-- Node capability: moves around. -->
    <string name="capability_mobile">Mobile</string>
    <!-- Node capability: sends and receives text messages. -->
    <string name="capability_text_messages">Text messages</string>
    <!-- Node capability: reports measurements. -->
    <string name="capability_telemetry">Telemetry</string>
    <!-- Node capability: hosts a shared conversation. -->
    <string name="capability_chat_room">Chat room</string>
    <!-- Node capability: answers CoAP requests. A protocol name; usually left untranslated. -->
    <string name="capability_coap">CoAP</string>

    <!-- Times. -->
    <!-- A list row's time for something that happened yesterday. -->
    <string name="time_yesterday">Yesterday</string>
    <!-- A line above messages sent today. The placeholder is a time of day, such as 9:40. Keep the annotation around the day, which is drawn in bold. -->
    <string name="date_line_today"><annotation type="day">Today</annotation> <xliff:g id="time" example="9:40">%1$s</xliff:g></string>
    <!-- A line above messages sent yesterday. The placeholder is a time of day, such as 6:12 PM. Keep the annotation around the day, which is drawn in bold. -->
    <string name="date_line_yesterday"><annotation type="day">Yesterday</annotation> <xliff:g id="time" example="6:12 PM">%1$s</xliff:g></string>
    <!-- An age under a minute, such as when a node was last heard. Lowercase: it ends sentences. -->
    <string name="age_just_now">just now</string>

    <!-- Navigation. -->
    <!-- Navigation destination: the list of conversations. -->
    <string name="nav_conversations">Conversations</string>
    <!-- Navigation destination: the nodes this phone knows. -->
    <string name="nav_peers">Peers</string>
    <!-- Navigation destination: the map of nodes. -->
    <string name="nav_map">Map</string>
    <!-- Navigation destination: the app's settings. -->
    <string name="nav_settings">Settings</string>
    <!-- TalkBack: the badge on Conversations, which counts conversations with unread messages, not messages. -->
    <plurals name="nav_unread_conversations">
        <item quantity="one"><xliff:g id="count" example="1">%d</xliff:g> conversation with unread messages</item>
        <item quantity="other"><xliff:g id="count" example="2">%d</xliff:g> conversations with unread messages</item>
    </plurals>
    <!-- TalkBack: the top app bar's button that returns to the previous page. -->
    <string name="action_back">Back</string>
    <!-- The empty detail pane beside the conversation list on a tablet. -->
    <string name="no_conversation_selected">No conversation selected</string>
    <!-- The empty detail pane beside the peer list on a tablet. -->
    <string name="no_peer_selected">No peer selected</string>
    <!-- Settings: header of the section about this phone's own identity. -->
    <string name="settings_section_identity">Identity</string>
    <!-- Settings row, and the title of the page it opens: this phone's own mesh identity. -->
    <string name="your_identity">Your identity</string>

    <!--
        The radio control: TalkBack reads its state as a list of these
        clauses, joined in the reader's language, for example "Companion
        radio T1000-E, connected, battery 78 percent".
    -->
    <!-- TalkBack clause: the companion radio, by its name. -->
    <string name="radio_tb_name">Companion radio <xliff:g id="name" example="T1000-E">%1$s</xliff:g></string>
    <!-- TalkBack clause: the companion radio, before it has reported a name. -->
    <string name="radio_tb_unnamed">Companion radio</string>
    <!--
        TalkBack: joins two of the clauses below into one sentence; applied
        in turn to join them all. A plain clause join, never "and": "Companion
        radio T1000-E, connected". Used before Android 13, which joins them
        itself.
    -->
    <string name="radio_tb_clause_join"><xliff:g id="before" example="Companion radio T1000-E">%1$s</xliff:g>, <xliff:g id="after" example="connected">%2$s</xliff:g></string>
    <!-- TalkBack: the radio control when no companion radio is set up. -->
    <string name="radio_tb_not_set_up">No companion radio set up</string>
    <!-- TalkBack clause: the radio's link is up. Lowercase: it follows the radio's name. -->
    <string name="radio_tb_connected">connected</string>
    <!-- TalkBack clause: the radio's link is coming up for the first time. -->
    <string name="radio_tb_connecting">connecting</string>
    <!-- TalkBack clause: the radio's link is coming back after it was lost. -->
    <string name="radio_tb_reconnecting">reconnecting</string>
    <!-- TalkBack clause: the radio's link is down. -->
    <string name="radio_tb_disconnected">disconnected</string>
    <!-- TalkBack clause: connecting to the radio failed. -->
    <string name="radio_tb_failed">connection failed</string>
    <!-- TalkBack clause: the radio's live battery level. -->
    <plurals name="radio_tb_battery">
        <item quantity="one">battery <xliff:g id="percent" example="1">%d</xliff:g> percent</item>
        <item quantity="other">battery <xliff:g id="percent" example="78">%d</xliff:g> percent</item>
    </plurals>
    <!-- TalkBack clause: the battery level the radio reported before its link went down. An age follows it. -->
    <plurals name="radio_tb_last_battery">
        <item quantity="one">last battery <xliff:g id="percent" example="1">%d</xliff:g> percent</item>
        <item quantity="other">last battery <xliff:g id="percent" example="78">%d</xliff:g> percent</item>
    </plurals>
    <!-- TalkBack clause: the radio's battery is charging. -->
    <string name="radio_tb_charging">charging</string>
    <!-- TalkBack clause: the radio runs on external power. -->
    <string name="radio_tb_external_power">on external power</string>
    <!-- TalkBack clause: the radio measures its battery but has not reported a level. -->
    <string name="radio_tb_battery_unknown">battery level unavailable</string>

    <!-- Problem banners: a title, a detail line, at most one action. -->
    <!-- Banner title: no companion radio is set up. -->
    <string name="banner_no_radio_title">No radio set up</string>
    <!-- Banner detail under "No radio set up". -->
    <string name="banner_detail_choose_radio">Choose a radio to send and receive</string>
    <!-- Banner title: the companion radio's link is down. -->
    <string name="banner_disconnected_title">Radio disconnected</string>
    <!-- Banner title: Bluetooth is turned off on this phone. -->
    <string name="banner_bluetooth_off_title">Bluetooth is off</string>
    <!-- Banner title: Android's Nearby devices permission is not granted. "Nearby devices" is Android's name for the permission. -->
    <string name="banner_nearby_denied_title">Nearby devices not allowed</string>
    <!-- Banner detail under "Nearby devices not allowed". "it" is the permission. -->
    <string name="banner_detail_needs_permission">UMSH needs it to reach your radio</string>
    <!-- Banner title: connecting to the companion radio failed. -->
    <string name="banner_failed_title">Radio connection failed</string>
    <!-- Banner title: the radio refused to transmit something this phone sent. -->
    <string name="banner_tx_rejected_title">Radio rejected the transmission</string>
    <!-- Banner title: reading this phone's stored data failed. -->
    <string name="banner_data_load_title">Couldn’t load your data</string>
    <!-- Banner detail under "Couldn't load your data". -->
    <string name="banner_detail_data_load">Conversations and peers may be out of date</string>
    <!-- Banner action: reads the stored data again. -->
    <string name="banner_retry">Retry</string>
    <!-- Banner detail: the radio's name, then the battery level it last reported and how long ago, such as "T1000-E · Last battery 78%, 12 min. ago". -->
    <string name="banner_detail_last_battery"><xliff:g id="radio" example="T1000-E">%1$s</xliff:g> · Last battery <xliff:g id="percent" example="78%">%2$s</xliff:g>, <xliff:g id="age" example="12 min. ago">%3$s</xliff:g></string>
    <!-- Banner detail: why the radio refused, the radio's name, and its live battery level, such as "Duty cycle limit · T1000-E · Battery 52%". -->
    <string name="banner_detail_reason_battery"><xliff:g id="reason" example="Duty cycle limit">%1$s</xliff:g> · <xliff:g id="radio" example="T1000-E">%2$s</xliff:g> · Battery <xliff:g id="percent" example="52%">%3$s</xliff:g></string>
    <!-- Banner detail: why the radio refused, and the radio's name, when it reports no battery level. -->
    <string name="banner_detail_reason_radio"><xliff:g id="reason" example="Duty cycle limit">%1$s</xliff:g> · <xliff:g id="radio" example="T1000-E">%2$s</xliff:g></string>
    <!-- Why the radio refused a transmission: it has used its share of airtime for now. -->
    <string name="banner_reason_duty_cycle">Duty cycle limit</string>
    <!-- Why the radio refused a transmission: it heard the channel in use. -->
    <string name="banner_reason_channel_busy">Channel busy</string>
    <!-- Why the radio refused a transmission: it stayed busy with other work. -->
    <string name="banner_reason_radio_busy">Radio busy</string>
    <!-- Why the radio refused a transmission: its queue had no room. -->
    <string name="banner_reason_queue_full">Radio queue full</string>
    <!-- Why the radio refused a transmission, for a status this app has no words for. The placeholder is the radio's status name, such as INVALID_STATE. -->
    <string name="banner_reason_status">Status <xliff:g id="status" example="INVALID_STATE">%1$s</xliff:g></string>
    <!-- Common dialog buttons. -->
