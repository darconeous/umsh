<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window behind Compose; the app's colors come from its Compose theme. -->
    <style name="Theme.Umsh" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Theme.SplashScreen defaults the icon to the system's generic one. -->
    <style name="Theme.Umsh.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Umsh</item>
    </style>
</resources>
