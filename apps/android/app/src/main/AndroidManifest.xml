<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Finding and connecting to the companion radio (Nearby devices). Never
        used for location. Declared now; nothing asks for them until the
        Bluetooth radio search arrives (Phase 2).
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
        No backup and no device-to-device transfer: restoring frame-counter
        reservations or the database onto another phone would reuse counters
        and break peers' replay windows.
    -->
    <application
        android:name=".app.UmshApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:manageSpaceActivity=".app.ManageSpaceActivity"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Umsh">

        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Umsh.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            App info › Storage shows Manage space in place of Clear storage,
            so storage is never wiped without saying what goes with it.
            Not exported: Settings runs as the system, which starts it
            anyway; no other app may.
        -->
        <activity
            android:name=".app.ManageSpaceActivity"
            android:exported="false"
            android:label="@string/manage_space_title"
            android:theme="@style/Theme.Umsh" />
    </application>

</manifest>
