<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Debug builds only: the bridged radio, a `umsh-bridge` host interface
        over TCP. Changing network state is also what lets its
        connected-device service start on Android 14 and later, with no
        Bluetooth permission granted.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <application>
        <!--
            Debug builds only: the design gallery. Exported, with no intent
            filter, so `adb shell am start -n` reaches it for screenshot runs.
        -->
        <activity
            android:name=".app.debug.DesignGalleryActivity"
            android:exported="true"
            android:label="@string/gallery_title"
            android:theme="@style/Theme.Umsh" />

        <!-- Debug builds only: Connect a radio over the fake search (D6). -->
        <activity
            android:name=".app.debug.ConnectRadioPreviewActivity"
            android:exported="true"
            android:theme="@style/Theme.Umsh" />
    </application>
</manifest>
