<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
            Debug builds only: the design gallery. Exported, with no intent
            filter, so `adb shell am start -n` reaches it for screenshot runs.
        -->
        <activity
            android:name=".app.debug.DesignGalleryActivity"
            android:exported="true"
            android:label="@string/gallery_title"
            android:theme="@style/Theme.Umsh" />

        <!-- Debug builds only: Connect a radio over the fake search (D6). -->
        <activity
            android:name=".app.debug.ConnectRadioPreviewActivity"
            android:exported="true"
            android:theme="@style/Theme.Umsh" />
    </application>
</manifest>
