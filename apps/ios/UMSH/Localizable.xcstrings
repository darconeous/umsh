    },
    "-122.2495" : {

    },
    "“%@…”" : {
      "comment" : "A message quoted in a notification, cut short. Use your language's quotation marks and ellipsis."
    },
    "“%@”" : {
      "comment" : "A message quoted in a notification. Use your language's quotation marks.\nUnder a renamed node's name: the name it advertises for itself."
    },
    "%@  %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@  %2$@"
          }
        }
      }
    },
    "%@ · “%@”" : {
      "comment" : "Under a renamed node's name: its role, then the name it advertises for itself.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · “%2$@”"
          }
        }
      }
    },
    "%@ · %@" : {
      "comment" : "A Discover result's subtitle: whether the peer is saved or when it was last heard, then its role.\nA radio reading: signal strength, then signal-to-noise ratio.\nAn earlier ping: its round trip, then how many hops it took.\nDevice setup: a radio profile as one line. The placeholders are the frequency and the transmit power, each with its unit.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ · %@ BW · SF%lld · 4/%lld · %@" : {
      "comment" : "Device setup: a radio profile as one line: frequency, bandwidth, spreading factor, coding rate, and transmit power, each figure with its unit. BW is bandwidth, SF the spreading factor.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@ BW · SF%3$lld · 4/%4$lld · %5$@"
          }
        }
      }
    },
    "%@ · within %@" : {
      "comment" : "Under a peer's map: when the location was heard, then the size of the area it names.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · within %2$@"
          }
        }
      }
    },
    "%@ (%@)" : {
      "comment" : "A temperature in the locale's unit, then in degrees Celsius. Both placeholders are formatted temperatures.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$@)"
          }
        }
      }
    },
    "%@ %@" : {
      "comment" : "Status text, like an IRC /me: a person's name, then what they say they did.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ dB" : {
      "comment" : "A signal-to-noise ratio, in decibels. The placeholder is a number."
    },
    "%@ dBm" : {
      "comment" : "A power level, such as a signal strength or a transmit power, in decibel-milliwatts. The placeholder is a number."
    },
    "%@ details" : {

    },
